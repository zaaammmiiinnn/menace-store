# ==========================================
# MENACE STOREFRONT & ADMIN ENVIRONMENT VARIABLES
# ==========================================

# --- Clerk Authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/account

# --- Admin Panel RBAC & Bootstrapping ---
# Comma-separated list of emails automatically granted 'admin' privileges
ADMIN_EMAILS=zamin@menace.store,admin@menace.store

# --- Cloudflare D1 Database ---
D1_DATABASE_ID=your-d1-database-id-from-cloudflare-dash

# --- Cloudflare R2 Image Storage ---
R2_BUCKET_NAME=menace-assets
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_DOMAIN=https://assets.menace.store

# --- Cloudflare KV Caching ---
MENACE_KV_ID=your-kv-namespace-id

# --- Razorpay Payment Gateway (Legacy / Alternative) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=your_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- PayU India Live Payment Gateway ---
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_MERCHANT_SALT=your_payu_salt
PAYU_MERCHANT_ID=your_payu_merchant_id
PAYU_CLIENT_ID=your_payu_client_id
PAYU_CLIENT_SECRET=your_payu_client_secret
PAYU_MODE=live # or test
NEXT_PUBLIC_PAYU_KEY=your_payu_merchant_key
NEXT_PUBLIC_PAYU_MODE=live

# --- Resend Automated Email Delivery ---
# Sign up free at https://resend.com (3,000 free emails/month)
RESEND_API_KEY=re_your_resend_api_key
# Use onboarding@resend.dev for testing, or orders@yourdomain.com once domain is verified
RESEND_FROM_EMAIL="MENANCE <orders@menance.store>"
