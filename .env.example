# ==========================================
# MENACE STOREFRONT & ADMIN ENVIRONMENT VARIABLES
# ==========================================

# --- Clerk Authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/account

# --- Admin Panel RBAC & Bootstrapping ---
# Comma-separated list of emails automatically granted 'admin' privileges
ADMIN_EMAILS=zamin@menace.store,admin@menace.store

# --- Cloudflare D1 Database ---
D1_DATABASE_ID=your-d1-database-id-from-cloudflare-dash

# --- Cloudflare R2 Image Storage ---
R2_BUCKET_NAME=menace-assets
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_DOMAIN=https://assets.menace.store

# --- Cloudflare KV Caching ---
MENACE_KV_ID=your-kv-namespace-id

# --- Razorpay Payment Gateway (Indian D2C) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=your_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
